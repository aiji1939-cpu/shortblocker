name: Build Shorts Blocker APK

on:
  workflow_dispatch:
  push:
    paths:
      - '.github/workflows/build.yml'

permissions:
  contents: write

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17

      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: 8.9

      - name: Create project files
        run: |
          cat > settings.gradle.kts <<'EOF_FILE'
          pluginManagement {
              repositories {
                  google()
                  mavenCentral()
                  gradlePluginPortal()
              }
          }
          dependencyResolutionManagement {
              repositoriesMode.set(RepositoriesMode.FAIL_ON_PROJECT_REPOS)
              repositories {
                  google()
                  mavenCentral()
              }
          }
          rootProject.name = "ShortsBlocker"
          include(":app")
          EOF_FILE
          cat > build.gradle.kts <<'EOF_FILE'
          plugins {
              id("com.android.application") version "8.5.2" apply false
              id("org.jetbrains.kotlin.android") version "1.9.24" apply false
          }
          EOF_FILE
          cat > gradle.properties <<'EOF_FILE'
          org.gradle.jvmargs=-Xmx2048m -Dfile.encoding=UTF-8
          android.useAndroidX=true
          kotlin.code.style=official
          EOF_FILE
          mkdir -p app
          cat > app/build.gradle.kts <<'EOF_FILE'
          plugins {
              id("com.android.application")
              id("org.jetbrains.kotlin.android")
          }

          android {
              namespace = "com.example.shortsblocker"
              compileSdk = 34

              defaultConfig {
                  applicationId = "com.example.shortsblocker"
                  minSdk = 26
                  targetSdk = 34
                  versionCode = 1
                  versionName = "1.0"
              }

              buildTypes {
                  release {
                      isMinifyEnabled = false
                  }
              }
              compileOptions {
                  sourceCompatibility = JavaVersion.VERSION_17
                  targetCompatibility = JavaVersion.VERSION_17
              }
              kotlinOptions {
                  jvmTarget = "17"
              }
          }
          EOF_FILE
          mkdir -p app/src/main
          cat > app/src/main/AndroidManifest.xml <<'EOF_FILE'
          <?xml version="1.0" encoding="utf-8"?>
          <manifest xmlns:android="http://schemas.android.com/apk/res/android">

              <application
                  android:allowBackup="false"
                  android:label="@string/app_name"
                  android:theme="@android:style/Theme.Material.Light.NoActionBar">

                  <activity
                      android:name=".MainActivity"
                      android:exported="true">
                      <intent-filter>
                          <action android:name="android.intent.action.MAIN" />
                          <category android:name="android.intent.category.LAUNCHER" />
                      </intent-filter>
                  </activity>

                  <service
                      android:name=".BlockerService"
                      android:exported="false"
                      android:label="@string/app_name"
                      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
                      <intent-filter>
                          <action android:name="android.accessibilityservice.AccessibilityService" />
                      </intent-filter>
                      <meta-data
                          android:name="android.accessibilityservice"
                          android:resource="@xml/accessibility_service_config" />
                  </service>
              </application>
          </manifest>
          EOF_FILE
          mkdir -p app/src/main/res/xml
          cat > app/src/main/res/xml/accessibility_service_config.xml <<'EOF_FILE'
          <?xml version="1.0" encoding="utf-8"?>
          <accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
              android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
              android:accessibilityFeedbackType="feedbackGeneric"
              android:accessibilityFlags="flagReportViewIds"
              android:canRetrieveWindowContent="true"
              android:description="@string/service_description"
              android:notificationTimeout="100"
              android:packageNames="com.instagram.android,com.google.android.youtube" />
          EOF_FILE
          mkdir -p app/src/main/res/values
          cat > app/src/main/res/values/strings.xml <<'EOF_FILE'
          <?xml version="1.0" encoding="utf-8"?>
          <resources>
              <string name="app_name">Shorts Blocker</string>
              <string name="service_description">Detects Instagram Reels and YouTube Shorts screens and closes them. It only looks at screen structure on those two apps and never reads or stores your content.</string>
          </resources>
          EOF_FILE
          mkdir -p app/src/main/java/com/example/shortsblocker
          cat > app/src/main/java/com/example/shortsblocker/BlockerService.kt <<'EOF_FILE'
          package com.example.shortsblocker

          import android.accessibilityservice.AccessibilityService
          import android.content.Intent
          import android.content.SharedPreferences
          import android.graphics.Color
          import android.graphics.PixelFormat
          import android.graphics.Rect
          import android.os.Handler
          import android.os.Looper
          import android.view.Gravity
          import android.view.View
          import android.view.WindowManager
          import android.view.accessibility.AccessibilityEvent
          import android.view.accessibility.AccessibilityNodeInfo
          import android.widget.FrameLayout
          import android.widget.TextView
          import android.widget.Toast
          import java.util.Calendar

          class BlockerService : AccessibilityService() {

              private val handler = Handler(Looper.getMainLooper())
              private var checkScheduled = false
              private var watching = false
              private var missCount = 0
              private var lastBlockAt = 0L

              private lateinit var wm: WindowManager
              private lateinit var prefs: SharedPreferences

              private val feedOverlay = Overlay("Feed hidden")
              private val tabOverlay = Overlay(null)

              private val checkRunnable = Runnable {
                  checkScheduled = false
                  try {
                      check()
                  } catch (e: Exception) {
                      // never let a bad screen crash the service
                  }
                  if (watching) schedule(POLL_MS)
              }

              override fun onServiceConnected() {
                  super.onServiceConnected()
                  wm = getSystemService(WINDOW_SERVICE) as WindowManager
                  prefs = getSharedPreferences(MainActivity.PREFS, MODE_PRIVATE)
              }

              // Events only wake the checker up. The checker itself runs at most every
              // EVENT_DELAY_MS, and keeps re-checking while Instagram/YouTube is on screen,
              // so the blackout appears by itself without needing a refresh.
              override fun onAccessibilityEvent(event: AccessibilityEvent?) {
                  val ev = event ?: return
                  val pkg = ev.packageName?.toString() ?: return
                  if (pkg != INSTAGRAM && pkg != YOUTUBE) return
                  watching = true
                  schedule(EVENT_DELAY_MS)
              }

              private fun schedule(delay: Long) {
                  if (checkScheduled) return
                  checkScheduled = true
                  handler.postDelayed(checkRunnable, delay)
              }

              private fun check() {
                  val root = rootInActiveWindow
                  val pkg = root?.packageName?.toString()

                  if (root == null) {
                      // Transitions can briefly have no window. Give up only if it lasts.
                      missCount++
                      if (missCount > 6) {
                          watching = false
                          hideOverlays()
                      }
                      return
                  }
                  missCount = 0

                  if (pkg != INSTAGRAM && pkg != YOUTUBE) {
                      // Another app is in front now: stop polling and remove overlays.
                      watching = false
                      hideOverlays()
                      return
                  }

                  if (!isBlockingTime()) {
                      hideOverlays()
                      return
                  }

                  if (pkg == INSTAGRAM) checkInstagram(root) else checkYoutube(root)
              }

              // ---- Block hours --------------------------------------------------------

              private fun isBlockingTime(): Boolean {
                  if (!prefs.getBoolean(MainActivity.KEY_USE_HOURS, false)) return true
                  val start = prefs.getInt(MainActivity.KEY_START, 9 * 60)
                  val end = prefs.getInt(MainActivity.KEY_END, 18 * 60)
                  val c = Calendar.getInstance()
                  val now = c.get(Calendar.HOUR_OF_DAY) * 60 + c.get(Calendar.MINUTE)
                  return when {
                      start == end -> true
                      start < end -> now in start until end
                      else -> now >= start || now < end // window crosses midnight
                  }
              }

              // ---- Instagram ------------------------------------------------------------

              private fun checkInstagram(root: AccessibilityNodeInfo) {
                  val home = findNode(root, ID_HOME_TAB, "Home")
                  val clips = findNode(root, ID_CLIPS_TAB, "Reels")
                  val clipsSelected = clips != null && (clips.isSelected || clips.isChecked)

                  val onReels = prefs.getBoolean(MainActivity.KEY_REELS, true) &&
                      (clipsSelected || isReelsScreen(root))

                  if (onReels) {
                      hideOverlays()
                      if (cooldownOk()) {
                          // From the Reels tab, jump to Home instead of backing out of the app.
                          val moved = clipsSelected && home != null && clickNode(home)
                          if (!moved) performGlobalAction(GLOBAL_ACTION_BACK)
                          Toast.makeText(this, "Blocked", Toast.LENGTH_SHORT).show()
                      }
                      return
                  }

                  val dm = resources.displayMetrics
                  val r = Rect()

                  // Home feed: black out everything under the stories row, down to the tab bar.
                  val onHome = home != null && (home.isSelected || home.isChecked)
                  if (prefs.getBoolean(MainActivity.KEY_FEED, true) && home != null && onHome) {
                      home.getBoundsInScreen(r)
                      val top = dm.heightPixels * prefs.getInt(MainActivity.KEY_TOP_PCT, 24) / 100
                      if (r.top > top) {
                          feedOverlay.show(Rect(0, top, dm.widthPixels, r.top))
                      } else {
                          feedOverlay.hide()
                      }
                  } else {
                      feedOverlay.hide()
                  }

                  // Reels tab: cover it so it can't be tapped.
                  if (prefs.getBoolean(MainActivity.KEY_REELS_TAB, true) && clips != null) {
                      clips.getBoundsInScreen(r)
                      tabOverlay.show(Rect(r))
                  } else {
                      tabOverlay.hide()
                  }
              }

              // ---- YouTube --------------------------------------------------------------

              private fun checkYoutube(root: AccessibilityNodeInfo) {
                  hideOverlays()
                  if (prefs.getBoolean(MainActivity.KEY_SHORTS, true) && isShortsScreen(root)) {
                      if (cooldownOk()) {
                          performGlobalAction(GLOBAL_ACTION_BACK)
                          Toast.makeText(this, "Blocked", Toast.LENGTH_SHORT).show()
                      }
                  }
              }

              // ---- Helpers --------------------------------------------------------------

              private fun cooldownOk(): Boolean {
                  val now = System.currentTimeMillis()
                  if (now - lastBlockAt < COOLDOWN_MS) return false
                  lastBlockAt = now
                  return true
              }

              // View ids come from the apps' own layouts and can change with app updates.
              private fun isReelsScreen(root: AccessibilityNodeInfo): Boolean =
                  hasAnyId(
                      root,
                      listOf(
                          "com.instagram.android:id/clips_viewer_view_pager",
                          "com.instagram.android:id/clips_viewer_container",
                          "com.instagram.android:id/clips_viewer_fragment_container",
                          "com.instagram.android:id/clips_viewer_video_layout"
                      )
                  )

              private fun isShortsScreen(root: AccessibilityNodeInfo): Boolean =
                  hasAnyId(
                      root,
                      listOf(
                          "com.google.android.youtube:id/reel_player_page_container",
                          "com.google.android.youtube:id/reel_recycler",
                          "com.google.android.youtube:id/shorts_container",
                          "com.google.android.youtube:id/reel_watch_fragment_root"
                      )
                  )

              private fun hasAnyId(root: AccessibilityNodeInfo, ids: List<String>): Boolean {
                  for (id in ids) {
                      val nodes = root.findAccessibilityNodeInfosByViewId(id)
                      if (!nodes.isNullOrEmpty() && nodes.any { it.isVisibleToUser }) return true
                  }
                  return false
              }

              private fun findNode(root: AccessibilityNodeInfo, id: String, desc: String): AccessibilityNodeInfo? {
                  root.findAccessibilityNodeInfosByViewId(id)
                      ?.firstOrNull { it.isVisibleToUser }
                      ?.let { return it }

                  // Fallback: look for the tab by its description, in the bottom part of the screen.
                  val minTop = resources.displayMetrics.heightPixels * 0.8f
                  val r = Rect()
                  return root.findAccessibilityNodeInfosByText(desc)?.firstOrNull {
                      it.isVisibleToUser &&
                          (it.contentDescription?.toString()?.startsWith(desc, true) == true) &&
                          run {
                              it.getBoundsInScreen(r)
                              r.top >= minTop
                          }
                  }
              }

              private fun clickNode(node: AccessibilityNodeInfo): Boolean {
                  var n: AccessibilityNodeInfo? = node
                  var depth = 0
                  while (n != null && depth < 4) {
                      if (n.isClickable) return n.performAction(AccessibilityNodeInfo.ACTION_CLICK)
                      n = n.parent
                      depth++
                  }
                  return false
              }

              private fun hideOverlays() {
                  feedOverlay.hide()
                  tabOverlay.hide()
              }

              private inner class Overlay(private val label: String?) {
                  private var view: View? = null
                  private var rect = Rect()

                  fun show(r: Rect) {
                      if (r.width() <= 0 || r.height() <= 0) {
                          hide()
                          return
                      }
                      try {
                          val lp = WindowManager.LayoutParams(
                              r.width(),
                              r.height(),
                              WindowManager.LayoutParams.TYPE_ACCESSIBILITY_OVERLAY,
                              WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE or
                                  WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN or
                                  WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS,
                              PixelFormat.OPAQUE
                          ).apply {
                              gravity = Gravity.TOP or Gravity.START
                              x = r.left
                              y = r.top
                          }
                          val v = view
                          if (v == null) {
                              val frame = FrameLayout(this@BlockerService)
                              frame.setBackgroundColor(Color.BLACK)
                              if (label != null) {
                                  val tv = TextView(this@BlockerService)
                                  tv.text = label
                                  tv.setTextColor(Color.DKGRAY)
                                  tv.textSize = 16f
                                  tv.gravity = Gravity.CENTER
                                  frame.addView(
                                      tv,
                                      FrameLayout.LayoutParams(
                                          FrameLayout.LayoutParams.MATCH_PARENT,
                                          FrameLayout.LayoutParams.MATCH_PARENT
                                      )
                                  )
                              }
                              wm.addView(frame, lp)
                              view = frame
                              rect = Rect(r)
                          } else if (r != rect) {
                              wm.updateViewLayout(v, lp)
                              rect = Rect(r)
                          }
                      } catch (e: Exception) {
                          // keep the current state; the next check will try again
                      }
                  }

                  fun hide() {
                      val v = view ?: return
                      view = null
                      try {
                          wm.removeView(v)
                      } catch (e: Exception) {
                          // already gone
                      }
                  }
              }

              override fun onInterrupt() {
                  watching = false
                  handler.removeCallbacks(checkRunnable)
                  checkScheduled = false
                  hideOverlays()
              }

              override fun onUnbind(intent: Intent?): Boolean {
                  watching = false
                  handler.removeCallbacks(checkRunnable)
                  checkScheduled = false
                  hideOverlays()
                  return super.onUnbind(intent)
              }

              companion object {
                  private const val INSTAGRAM = "com.instagram.android"
                  private const val YOUTUBE = "com.google.android.youtube"
                  private const val ID_HOME_TAB = "com.instagram.android:id/feed_tab"
                  private const val ID_CLIPS_TAB = "com.instagram.android:id/clips_tab"
                  private const val EVENT_DELAY_MS = 120L
                  private const val POLL_MS = 400L
                  private const val COOLDOWN_MS = 700L
              }
          }
          EOF_FILE
          mkdir -p app/src/main/java/com/example/shortsblocker
          cat > app/src/main/java/com/example/shortsblocker/MainActivity.kt <<'EOF_FILE'
          package com.example.shortsblocker

          import android.app.Activity
          import android.app.TimePickerDialog
          import android.content.Intent
          import android.content.SharedPreferences
          import android.graphics.Color
          import android.graphics.Typeface
          import android.net.Uri
          import android.os.Bundle
          import android.provider.Settings
          import android.view.ViewGroup
          import android.widget.Button
          import android.widget.LinearLayout
          import android.widget.ScrollView
          import android.widget.SeekBar
          import android.widget.Switch
          import android.widget.TextView

          class MainActivity : Activity() {

              private lateinit var prefs: SharedPreferences
              private lateinit var statusView: TextView

              override fun onCreate(savedInstanceState: Bundle?) {
                  super.onCreate(savedInstanceState)
                  prefs = getSharedPreferences(PREFS, MODE_PRIVATE)
                  val pad = (20 * resources.displayMetrics.density).toInt()

                  val layout = LinearLayout(this).apply {
                      orientation = LinearLayout.VERTICAL
                      setPadding(pad, pad * 2, pad, pad * 2)
                  }
                  val scroll = ScrollView(this).apply {
                      layoutParams = ViewGroup.LayoutParams(
                          ViewGroup.LayoutParams.MATCH_PARENT,
                          ViewGroup.LayoutParams.MATCH_PARENT
                      )
                      addView(layout)
                  }

                  fun heading(text: String) {
                      layout.addView(TextView(this).apply {
                          this.text = text
                          textSize = 20f
                          typeface = Typeface.DEFAULT_BOLD
                          setPadding(0, pad, 0, pad / 4)
                      })
                  }

                  fun toggle(label: String, key: String, default: Boolean) {
                      layout.addView(Switch(this).apply {
                          text = label
                          textSize = 17f
                          isChecked = prefs.getBoolean(key, default)
                          setPadding(0, pad / 2, 0, pad / 2)
                          setOnCheckedChangeListener { _, checked ->
                              prefs.edit().putBoolean(key, checked).apply()
                          }
                      })
                  }

                  fun timeButton(prefix: String, key: String, default: Int) {
                      val b = Button(this)
                      fun refresh() {
                          b.text = prefix + ": " + format12(prefs.getInt(key, default))
                      }
                      refresh()
                      b.setOnClickListener {
                          val cur = prefs.getInt(key, default)
                          TimePickerDialog(
                              this,
                              { _, h, m ->
                                  prefs.edit().putInt(key, h * 60 + m).apply()
                                  refresh()
                              },
                              cur / 60,
                              cur % 60,
                              false
                          ).show()
                      }
                      layout.addView(b)
                  }

                  layout.addView(TextView(this).apply {
                      text = "Shorts Blocker"
                      textSize = 28f
                      typeface = Typeface.DEFAULT_BOLD
                  })
                  statusView = TextView(this).apply {
                      textSize = 18f
                      typeface = Typeface.DEFAULT_BOLD
                      setPadding(0, pad / 2, 0, pad / 2)
                  }
                  layout.addView(statusView)
                  layout.addView(Button(this).apply {
                      text = "Open Accessibility Settings"
                      setOnClickListener {
                          startActivity(Intent(Settings.ACTION_ACCESSIBILITY_SETTINGS))
                      }
                  })
                  layout.addView(Button(this).apply {
                      text = "Battery: set to Unrestricted"
                      setOnClickListener {
                          startActivity(
                              Intent(
                                  Settings.ACTION_APPLICATION_DETAILS_SETTINGS,
                                  Uri.parse("package:" + packageName)
                              )
                          )
                      }
                  })
                  layout.addView(TextView(this).apply {
                      text = "If the service keeps switching itself off: open App battery usage here and choose Unrestricted."
                      textSize = 13f
                  })

                  heading("What to block")
                  toggle("Block Instagram Reels", KEY_REELS, true)
                  toggle("Block YouTube Shorts", KEY_SHORTS, true)
                  toggle("Black out Instagram home feed", KEY_FEED, true)
                  toggle("Hide Instagram Reels tab", KEY_REELS_TAB, true)

                  val pctLabel = TextView(this).apply { textSize = 15f }
                  fun refreshPct(p: Int) {
                      pctLabel.text = "Feed blackout starts $p% from the top of the screen"
                  }
                  layout.addView(pctLabel)
                  layout.addView(SeekBar(this).apply {
                      max = 40
                      progress = prefs.getInt(KEY_TOP_PCT, 24) - 10
                      refreshPct(progress + 10)
                      setOnSeekBarChangeListener(object : SeekBar.OnSeekBarChangeListener {
                          override fun onProgressChanged(sb: SeekBar?, value: Int, fromUser: Boolean) {
                              refreshPct(value + 10)
                              prefs.edit().putInt(KEY_TOP_PCT, value + 10).apply()
                          }

                          override fun onStartTrackingTouch(sb: SeekBar?) {}
                          override fun onStopTrackingTouch(sb: SeekBar?) {}
                      })
                  })
                  layout.addView(TextView(this).apply {
                      text = "Move this until the stories row stays visible and the feed below it is black."
                      textSize = 13f
                  })

                  heading("Block hours")
                  toggle("Only block during these hours", KEY_USE_HOURS, false)
                  timeButton("Start", KEY_START, 9 * 60)
                  timeButton("End", KEY_END, 18 * 60)
                  layout.addView(TextView(this).apply {
                      text = "Outside these hours everything works normally. If the switch above is off, blocking is always on."
                      textSize = 13f
                  })

                  setContentView(scroll)
              }

              override fun onResume() {
                  super.onResume()
                  refreshStatus()
              }

              private fun refreshStatus() {
                  val enabled = Settings.Secure.getString(
                      contentResolver,
                      Settings.Secure.ENABLED_ACCESSIBILITY_SERVICES
                  ) ?: ""
                  if (enabled.contains(packageName + "/")) {
                      statusView.text = "Service is ON"
                      statusView.setTextColor(Color.rgb(0, 130, 60))
                  } else {
                      statusView.text = "Service is OFF - turn it on in Accessibility settings"
                      statusView.setTextColor(Color.rgb(190, 30, 30))
                  }
              }

              private fun format12(minutes: Int): String {
                  val h = minutes / 60
                  val m = minutes % 60
                  val h12 = if (h % 12 == 0) 12 else h % 12
                  val suffix = if (h < 12) "AM" else "PM"
                  return String.format("%d:%02d %s", h12, m, suffix)
              }

              companion object {
                  const val PREFS = "blocker_prefs"
                  const val KEY_REELS = "block_reels"
                  const val KEY_SHORTS = "block_shorts"
                  const val KEY_FEED = "block_feed"
                  const val KEY_REELS_TAB = "hide_reels_tab"
                  const val KEY_TOP_PCT = "feed_top_pct"
                  const val KEY_USE_HOURS = "use_hours"
                  const val KEY_START = "start_min"
                  const val KEY_END = "end_min"
              }
          }
          EOF_FILE

      - name: Build debug APK
        run: gradle assembleDebug --no-daemon

      - name: Publish APK to Releases
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          gh release delete latest -y --cleanup-tag --repo ${{ github.repository }} || true
          gh release create latest app/build/outputs/apk/debug/app-debug.apk \
            --repo ${{ github.repository }} --target ${{ github.sha }} \
            --title "Shorts Blocker (latest)" \
            --notes "Download app-debug.apk and install it."
